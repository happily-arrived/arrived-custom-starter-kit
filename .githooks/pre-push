#!/bin/sh
# Block direct pushes to main — changes land via pull request.
# Enabled by `npm install` (the `prepare` script sets core.hooksPath to .githooks).

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done

exit 0
